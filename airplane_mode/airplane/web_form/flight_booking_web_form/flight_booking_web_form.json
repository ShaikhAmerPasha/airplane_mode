 "client_script": "frappe.ready(async () => {\n  const params = frappe.utils.get_query_params();\n  const flight = params.flight;\n  if (!flight) return;\n\n  // set the Flight link\n  await frappe.web_form.set_value('flight', flight);\n\n  // fetch and set the price\n  const r = await frappe.db.get_value('Airplane Flight', flight, ['flight_price']);\n  if (r && r.message && r.message.flight_price != null) {\n    await frappe.web_form.set_value('flight_price', r.message.flight_price);\n  }\n});\n",
